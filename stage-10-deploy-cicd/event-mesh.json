{
  "emname": "procurement-stage-10-emname",
  "version": "1.1.0",
  "namespace": "default/procurement-stage-10/1",
  "options": {
    "management": true,
    "messagingrest": true,
    "messaging": true
  },
  "rules": {
    "topicRules": {
      "publishFilter": [
        "${namespace}/*"
      ],
      "subscribeFilter": [
        "${namespace}/*",
        "sap/S4HANAOD/*"
      ]
    },
    "queueRules": {
      "publishFilter": [
        "${namespace}/*"
      ],
      "subscribeFilter": [
        "${namespace}/*"
      ]
    }
  },
  "authorities": [
    "$ACCEPT_GRANTED_AUTHORITIES"
  ]
}
