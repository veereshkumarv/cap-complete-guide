{
  "//": [
    "What: npm manifest of stage 10 (deploy cicd): CAP runtime (which also serves app/ statically), SAP Cloud SDK for the remote Business Partner API, SQLite for development, cds.test for tests, the start/watch/test scripts and the cds.requires entry of API_BUSINESS_PARTNER.",
    "Why: [CAP-M01] in CAP 10, cds init no longer writes a package.json; this file makes the folder a runnable Node.js CAP project (cds add nodejs equivalent).",
    "If missing or unlinked: cds watch cannot resolve @sap/cds or the SQLite driver, npm test has no script, and the folder is no longer a project."
  ],
  "name": "procurement-stage-10",
  "version": "1.0.0",
  "description": "ACME Procurement - stage 10: MTA deployment to SAP BTP Cloud Foundry (multitenant SaaS with approuter, HTML5 repository, HANA, XSUAA, messaging, audit log, object store) and CI/CD.",
  "private": true,
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "node --test \"test/**/*.test.js\"",
    "perf": "node --test \"test/perf/*.bench.js\"",
    "build": "cds build --production",
    "watch:sidecar": "cds watch mtx/sidecar",
    "watch:mtx": "cds watch --profile with-mtx",
    "subscribe": "sh scripts/subscribe.sh",
    "build:mtar": "sh scripts/build-mtar.sh",
    "deploy": "sh scripts/deploy.sh"
  },
  "dependencies": {
    "@cap-js/attachments": "^4.0.0",
    "@cap-js/audit-logging": "^1.3.0",
    "@cap-js/change-tracking": "^2.2.3",
    "@cap-js/hana": "^3",
    "@cap-js/telemetry": "^2.2.0",
    "@grpc/grpc-js": "^1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.223.2",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.2",
    "@opentelemetry/instrumentation-host-metrics": "^0.6.0",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10",
    "@sap/cds-mtxs": "^4",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "@sap/eslint-plugin-cds": "^4",
    "eslint": "^10",
    "globals": "^17.14.0",
    "yaml": "^2.9.1"
  },
  "cds": {
    "requires": {
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "[production]": {
          "credentials": {
            "destination": "S4_BP",
            "path": "/sap/opu/odata/sap/API_BUSINESS_PARTNER"
          }
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "alice": {
            "password": "",
            "roles": [
              "Requester"
            ],
            "tenant": "t1"
          },
          "fred": {
            "password": "",
            "roles": [
              "Requester"
            ],
            "tenant": "t2"
          },
          "bob": {
            "password": "",
            "roles": [
              "Approver"
            ],
            "tenant": "t1"
          },
          "carol": {
            "password": "",
            "roles": [
              "Buyer"
            ],
            "tenant": "t1"
          },
          "dave": {
            "password": "",
            "roles": [
              "Admin",
              "cds.ExtensionDeveloper"
            ],
            "tenant": "t1"
          },
          "erin": {
            "password": "",
            "roles": [
              "Auditor"
            ],
            "tenant": "t2"
          },
          "gina": {
            "password": "",
            "roles": [
              "Requester",
              "Approver"
            ],
            "tenant": "t1"
          },
          "*": false
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        },
        "multitenancy": true,
        "telemetry": {
          "kind": "to-cloud-logging"
        }
      },
      "messaging": {
        "kind": "local-messaging",
        "queued": true,
        "[production]": {
          "kind": "enterprise-messaging"
        }
      },
      "[with-mtx]": {
        "multitenancy": true
      },
      "extensibility": true,
      "html5-repo": true,
      "malware-scanner": true
    },
    "profile": "with-mtx-sidecar"
  }
}
