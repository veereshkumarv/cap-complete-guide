/**
 * What: CDS model of the remote S/4HANA Business Partner API, generated by
 *     `cds import srv/external/API_BUSINESS_PARTNER.edmx --as cds` (do not edit by hand).
 * Why: [CAP-M08] lets handlers query the remote API with CQL (`bp.run(SELECT.from(...))`) and lets
 *     cds watch mock it locally with the CSV files in srv/external/data/.
 * If missing or unlinked: ProcurementService.RemoteSuppliers cannot compile, and
 *     cds.connect.to('API_BUSINESS_PARTNER') fails with "no model".
 */
/* checksum : 4bcd99f982c79949d65edada3995c199 */
@cds.external : true
@m.IsDefaultEntityContainer : 'true'
@sap.supported.formats : 'atom json xlsx'
service API_BUSINESS_PARTNER {
  @cds.external : true
  @cds.persistence.skip : true
  @sap.searchable : 'true'
  @sap.content.version : '1'
  @sap.label : 'Business Partner'
  entity A_BusinessPartner {
    @sap.display.format : 'UpperCase'
    @sap.label : 'Business Partner'
    key BusinessPartner : String(10) not null;
    @sap.label : 'BP Category'
    BusinessPartnerCategory : String(1);
    @sap.label : 'Full Name'
    BusinessPartnerFullName : String(81);
    @sap.display.format : 'UpperCase'
    @sap.label : 'Grouping'
    BusinessPartnerGrouping : String(4);
    @sap.display.format : 'UpperCase'
    @sap.label : 'Industry'
    Industry : String(10);
    @sap.display.format : 'NonNegative'
    @sap.label : 'Central Block'
    BusinessPartnerIsBlocked : Boolean;
    @sap.display.format : 'Date'
    @sap.label : 'Created On'
    CreationDate : Date;
    @sap.display.format : 'Date'
    @sap.label : 'Last Changed On'
    LastChangeDate : Date;
    to_BusinessPartnerAddress : Association to many A_BusinessPartnerAddress {  };
  };

  @cds.external : true
  @cds.persistence.skip : true
  @sap.searchable : 'true'
  @sap.content.version : '1'
  @sap.label : 'BP Address'
  entity A_BusinessPartnerAddress {
    @sap.display.format : 'UpperCase'
    @sap.label : 'Business Partner'
    key BusinessPartner : String(10) not null;
    @sap.display.format : 'UpperCase'
    @sap.label : 'Address Number'
    key AddressID : String(10) not null;
    @sap.display.format : 'UpperCase'
    @sap.label : 'Country/Region Key'
    Country : String(3);
    @sap.label : 'City'
    CityName : String(40);
    @sap.display.format : 'UpperCase'
    @sap.label : 'Postal Code'
    PostalCode : String(10);
    @sap.label : 'Street'
    StreetName : String(60);
  };
};

